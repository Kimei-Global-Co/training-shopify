{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 749px) {
    .line-between {
      display: block!important;
      height: 1px;
      background-color: rgb(var(--color-foreground), 0.5);
    }
    .create-account {
      border: 1px solid black!important;
      padding: 1rem 2rem;
      color: white!important;
      text-decoration: none!important;
      background-color: rgba(var(--color-button), var(--alpha-button-background))!important;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .page-login {
      display: flex;
      margin: 5rem auto;
      justify-content: center;
    }
    .customer {
      width: 50%;
      margin: 0!important;
    }
    .register {
      width: 50%;
      margin: 0!important;

    }
    .line-between {
      display: block!important;
      width: 1px;
      background-color: rgb(var(--color-foreground), 0.5);
    }
    .create-account {
      background-color: black!important;
      color: white!important;
      text-decoration: none!important;
      padding: 1.25rem 3rem!important;
      font-size: 1.5rem!important;
    }
    .create-account:hover {
      background-color: #595656!important;
    }
  }
  label.required::after {
    content: " *";
    color: red;
    font-weight: bold;
    margin-left: 0px;
  }
  h2.form__message {
    display: none;
  }
  .errors {
    color: red;
  }
  #activation-success {
    text-align: center !important;
    color: green;
  }
  .spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 3px solid white;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-right: 1rem;
  }
  .customer button {
    margin: 4rem auto;
  }
  .hidden {
    display: none;
  }
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  .errors-custom-text,
  .error-email,
  .error-password {
    color: red;
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="page-login">
  <div class="customer login section-{{ section.id }}-padding">
    <h1 id="recover" tabindex="-1">
      {{ 'customer.recover_password.title' | t }}
    </h1>
    <div>
      <p>
        {{ 'customer.recover_password.subtext' | t }}
      </p>

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="field">
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
          <label for="RecoverEmail">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
        {%- if form.errors -%}
          <small id="RecoverEmail-email-error" class="form__message">
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{ form.errors.messages.form }}
          </small>
        {%- endif -%}

        <button>
          {{ 'customer.login_page.submit' | t }}
        </button>

        <a href="#login">
          {{ 'customer.login_page.cancel' | t }}
        </a>
      {%- endform -%}
    </div>

    <h1 id="login" tabindex="-1">
      {{ 'customer.login_page.title' | t }}
    </h1>
    <h3 class="errors-custom-text"></h3>
    <h3 id="activation-success" style="display:none;">
      {{ 'customer.register.activate_account_success' | t }}
    </h3>
    <div>
      {%- if recover_success == true -%}
        <h3 class="form__message" tabindex="-1" autofocus>
          <span class="svg-wrapper">
            {{- 'icon-success.svg' | inline_asset_content -}}
          </span>
          {{ 'customer.recover_password.success' | t }}
        </h3>
      {%- endif -%}
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <h2 class="form__message" tabindex="-1" autofocus>
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
          {{ form.errors | default_errors }}
        {%- endif -%}

        {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
          <section name="sign-in-with-shop-provider">
            {{ shop | login_button: hide_button: hide_shop_login_button }}

            {%- unless hide_shop_login_button -%}
              <p>
                {{ 'customer.login_page.alternate_provider_separator' | t }}
              </p>
            {%- endunless -%}
          </section>
        {%- endif -%}

        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
          <label for="CustomerEmail" class="required">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
        <p style="width: 100%; text-align: left; margin: 0;"><small class="error-email"></small></p>

        {%- if form.password_needed -%}
          <div class="field">
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.password' | t }}"
            >
            <label for="CustomerPassword" class="required">
              {{ 'customer.login_page.password' | t }}
            </label>
          </div>
          <p style="width: 100%; text-align: left; margin: 0;"><small class="error-password"></small></p>

          <a href="#recover">
            {{ 'customer.login_page.forgot_password' | t }}
          </a>
        {%- endif -%}

        <button class="btn-submit" style="display:flex; ">
          <span class="spinner hidden"></span>
          {{ 'customer.login_page.sign_in' | t }}
        </button>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div>
        <hr>
        <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

        {%- form 'guest_login' -%}
          <button>
            {{ 'customer.login_page.guest_continue' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
  <div class="line-between"></div>
  <div class="customer login section-{{ section.id }}-padding">
    <h1 id="login" tabindex="-1">
      {{ 'customer.login_page.create_account' | t }}
    </h1>
    <p>
      {{ 'customer.login_page.create_account_subtext' | t }}
    </p>
    <a href="{{ routes.account_register_url }}" class="create-account">
      {{ 'customer.login_page.create_account' | t }}
    </a>
  </div>
</div>
<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('status') === '200' && params.get('message') === 'success') {
    document.getElementById('activation-success').style.display = 'block';
  }
  window.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('customer_login');
    form.addEventListener('submit', async function (event) {
      document.getElementById('activation-success').style.display = "none";
      document.querySelector('.error-email').innerText = '';
      document.querySelector('.error-password').innerText = '';
      document.querySelector('.errors-custom-text').innerText = '';
      let email = document.querySelector('input[name="customer[email]"]');
      let password = document.querySelector('input[name="customer[password]"]');
      const apiCustomerCheckUrl = '{{ settings.domain_generate_api }}' + '/api/shopify/customers/login-check';
      const lang = document.documentElement.lang;
      const spinner = this.querySelector('.spinner');
      spinner.classList.remove('hidden');

      event.preventDefault();
      let values = {};
      values['email'] = email.value;
      values['password'] = password.value;
      values['locale'] = lang;

      fetch(apiCustomerCheckUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Shop-Domain': `{{ shop.domain }}`,
        },
        body: JSON.stringify(values),
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.status == 200) {
            form.submit();
          }
          if (data.errors) {
            if (data.errors.email_password_fail) {
              document.querySelector('.errors-custom-text').innerText = data.errors.email_password_fail;
            }
            if (data.errors.email) {
              document.querySelector('.error-email').innerText = data.errors.email[0];
            }
            if (data.errors.password) {
              document.querySelector('.error-password').innerText = data.errors.password[0];
            }
          }
          spinner.classList.add('hidden');
        })
        .catch((error) => console.error('Error:', error));
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
